# Junction environment. Copy to .env.local for local use; on Vercel set these in Project Settings ->
# Environment Variables (the Neon and Blob integrations add theirs automatically). Never commit real values.

# ---- Database (Postgres). Unset = local JSON files under backend/data/workspace.
# Neon via the Vercel Marketplace sets DATABASE_URL to its pooled connection; that is the one to use.
# If the integration was installed with a variable prefix (e.g. TRAFFIC_DATABASE_URL), that name works too;
# for any other prefix set JUNCTION_DB_ENV_PREFIX to it.
DATABASE_URL=postgresql://junction:junction@localhost:5432/junction
# JUNCTION_DB_ENV_PREFIX=
# Connections per process (API instance, worker, each training process). Keep low on small database plans.
DATABASE_POOL_MAX=5

# ---- Files (networks, fitted demand, trained models). Unset = local disk.
# Vercel Blob, private store. Connecting the store sets BLOB_STORE_ID; also add the store's read-write token
# (required: the API container cannot use Vercel's OIDC sign-in for Blob).
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=private

# ---- Where jobs run. local: inside the API process (one machine). queue: the API queues, workers run.
# Vercel production needs queue (functions stop between requests; the worker daemon does the work).
JUNCTION_EXECUTION=queue

# ---- Sign-in: currently switched off. To require accounts, set JUNCTION_AUTH=on and a long random secret
# (openssl rand -hex 32). Without JUNCTION_AUTH=on there is no sign-in page, even when JUNCTION_SECRET is set.
JUNCTION_AUTH=off
JUNCTION_SECRET=
# First account, created on start when no account exists. Remove after the first sign-in if you like.
JUNCTION_ADMIN_EMAIL=
JUNCTION_ADMIN_PASSWORD=
JUNCTION_SESSION_DAYS=14

# ---- Worker capacity (jobs at once per worker instance) and timing
JUNCTION_WORKER_RUNS=2
JUNCTION_WORKER_TRAININGS=1
JUNCTION_WORKER_BENCHMARKS=1
JUNCTION_WORKER_CALIBRATIONS=1
JUNCTION_WORKER_LIVE=2
# Parallel SUMO processes per job; default is CPU count - 1 (1 on a 2 GiB, 1 vCPU instance)
# TRAFFICSIM_WORKERS=1
# Seconds between checks for new work, and after 10 idle minutes (raise to let the database sleep)
JUNCTION_WORKER_POLL_S=2
JUNCTION_WORKER_IDLE_POLL_S=10
JUNCTION_WORKER_DRAIN_S=240
JUNCTION_LIVE_IDLE_S=300
JUNCTION_MAX_TRAININGS=2

# ---- External signal controllers: hosts the server may call (comma separated). Keep narrow on a shared server.
JUNCTION_CONTROLLER_HOSTS=localhost,127.0.0.1,::1
